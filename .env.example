# =============================================================================
# Velus Dashboard — variáveis de ambiente (exemplo)
# =============================================================================
# Copie para .env e ajuste para seu ambiente local.
# .env NUNCA vai pro repo (gitignored).
# Em produção, todos esses valores vêm de K8s Secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_ENV=development                          # development | production | test
DJANGO_SECRET_KEY=change-me-dev-only-not-for-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Sao_Paulo
DJANGO_LANGUAGE_CODE=pt-br
SESSION_COOKIE_AGE_DAYS=3                       # sessão deslizante: renova a cada request

# -----------------------------------------------------------------------------
# Database (Postgres 16)
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://velus:velus@localhost:5432/velus_dashboard

# -----------------------------------------------------------------------------
# Cache & broker (Redis 7)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -----------------------------------------------------------------------------
# Criptografia — Fernet (credenciais IXC e similares no DB)
# -----------------------------------------------------------------------------
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Em produção: vem de K8s Secret SEPARADO do Postgres password. Rotacionável.
FERNET_KEY=change-me-generate-with-fernet

# -----------------------------------------------------------------------------
# Google OAuth (django-allauth)
# -----------------------------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
# EMAIL_BACKEND é o FALLBACK — vale só enquanto o Mailgun não estiver configurado.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Velus Dashboard <noreply@velus.local>

# Mailgun (API HTTP via django-anymail). Preencher a chave LIGA o envio real —
# convite, reset de senha e digest de churn passam a sair de verdade.
# Chave: https://app.mailgun.com/settings/api_security (Sending API key).
# Domínio: precisa estar verificado (SPF/DKIM) em https://app.mailgun.com/mg/sending/domains
# Região EU: trocar MAILGUN_API_URL por https://api.eu.mailgun.net/v3
# NUNCA commitar a chave — em prod ela vive no K8s Secret dashboard-velus-secret.
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net/v3

# Validar o envio (imprime o backend ativo e o erro do Mailgun, se houver):
#   python manage.py send_test_email voce@exemplo.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console                              # console (dev) | json (prod)

# -----------------------------------------------------------------------------
# Observabilidade (opcional em dev)
# -----------------------------------------------------------------------------
# SENTRY_DSN=
